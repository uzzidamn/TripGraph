# ============================================================
# TripGraph AI — Unified Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# .env must NEVER be committed to Git.
# All bucket specs reference these exact variable names.
# Do NOT invent alternate env variable names in any bucket.
# ============================================================

# --- Neo4j (Local Docker instance) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tripgraph123

# --- LLM Configuration ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=your_gemini_api_key_here
LLM_TEMPERATURE=0

# --- FastAPI Backend ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Pipeline Mode (Bucket 2 vs 2.1) ---
# "agentic"   = Bucket 2  (LangGraph multi-agent pipeline — requires langchain/langgraph)
# "augmented" = Bucket 2.1 (Linear single-pass pipeline — requires google-generativeai only)
PIPELINE_MODE=augmented

# --- React Frontend (Vite) ---
VITE_API_URL=http://localhost:8000
