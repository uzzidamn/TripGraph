# ============================================================
# TripGraph AI — Unified Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# .env must NEVER be committed to Git.
# ============================================================

# --- Neo4j (Local Docker instance — optional; falls back to JSON store) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tripgraph123
NEO4J_RETRY_COOLDOWN_S=60

# --- LLM Configuration ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=your_gemini_api_key_here
LLM_TEMPERATURE=0
LLM_RATE_LIMIT_RPM=5

# --- External APIs (REQUIRED for trips outside the seeded routes) ---
# OpenRouteService — geocoding + driving routes (free 2,000/day tier)
# Sign up: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# Optional: country biasing (default IND). 3-letter ISO codes, comma-separated.
ORS_GEOCODE_COUNTRY=IND

# Geoapify — hotels + activities discovery (free 3,000/day tier)
# Sign up: https://myprojects.geoapify.com/register
GEOAPIFY_API_KEY=

# OpenWeatherMap — current weather + 3-day forecast (free 1,000/day tier)
# Sign up: https://home.openweathermap.org/users/sign_up
OPENWEATHERMAP_API_KEY=

# --- Pending API integrations (silent stubs — set a key to enable) ---
# Flights (pick one provider)
# SKYSCANNER_RAPID_API_KEY=
# AMADEUS_API_KEY=
# DUFFEL_API_KEY=

# Hotel deals / live pricing (pick one provider)
# BOOKING_RAPID_API_KEY=
# AGODA_PARTNER_API_KEY=
# HOTELBEDS_API_KEY=

# Traffic conditions (pick one provider)
# TOMTOM_API_KEY=
# HERE_API_KEY=
# GOOGLE_MAPS_API_KEY=

# --- Auth / Database ---
# SQLite (default — zero setup). Swap to PostgreSQL DSN for production.
DATABASE_URL=sqlite:///./tripgraph.db
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-32-char-string
JWT_EXPIRE_MINUTES=10080

# --- FastAPI Backend ---
API_HOST=0.0.0.0
API_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# --- Pipeline Mode ---
# "agentic"   = LangGraph multi-agent pipeline
# "augmented" = Linear single-pass pipeline (fewer deps)
PIPELINE_MODE=agentic

# --- React Frontend (Vite) ---
VITE_API_URL=http://localhost:8001
